# Obohacení korpusu (české glosy, klíčová slova, otázky, entity, témata).
# Dlouhý běh na týdny — spouští a zastavuje ho rag-schedule.sh podle denní doby.
#
# Jede na swarm-directorovi, ne na translate: obohacení se zapéká do databáze
# natrvalo, takže rozhoduje kvalita, ne rychlost (director je 2,8× pomalejší,
# ale v A/B na 30 chuncích psal věcně i gramaticky správněji). Noční okno je
# stejně prázdné. --max-tokens 1300, protože director píše delší glosy
# (⌀ 254 znaků proti 137) a do 900 se mu občas nevešly.
#
# --order breadth: n-tý chunk každého díla, teprve pak (n+1)-ní. Po každé
# noci má tedy kus obohacení KAŽDÉ dílo a katalog i témata fungují napříč
# knihovnou — místo aby byla po prvním týdnu hotová jen Avesta.
#
# Klient sám skončí (kód 3), když z 60+ pokusů uspěje míň než 10 % — rozbitý
# model se pozná až podle výstupu, ne podle /v1/models.
#
# Restart=on-failure schválně: `systemctl --user stop` (denní režim) i čistý
# konec po dojetí fronty mají službu nechat stát. Pád modelu naopak vede
# k opakování — resume je v Postgresu přes input_sha, takže se nic nezopakuje.
#
# Postup po dojetí priority 1: přepsat --priority na 2 a znovu enable/start.

[Unit]
Description=Obohacení knihovního korpusu (swarm-director, priorita 1)
After=network-online.target
# Když klient skončí s ModelUnusable (rozbitý model), nemá smysl ho pouštět
# dokola celou noc — tři pokusy za hodinu a dost, v journalu je pak jedna
# jasná hláška místo sedmi set řádků „500 Internal server error".
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/deploy/WorldLibraryProject/rag
# --workers MUSÍ zůstat pod --max-num-seqs directora (16), jinak obohacení
# obsadí všechny sloty a chat knihovny čeká ve frontě: 2. 9. 2026 naměřeno
# `Running: 16 reqs, Waiting: 2`, průchodnost na dotaz spadla z 15,6 na
# ~3 tok/s a odpověď nedorazila do dvou minut. 12 nechává čtyři sloty chatu;
# obohacení je o čtvrtinu pomalejší, ale běží celou noc, kdežto na chat se
# čeká živý člověk.
ExecStart=%h/deploy/WorldLibraryProject/rag/.venv/bin/python3 enrich_chunks.py \
    --llm-url http://localhost:8012/v1 --model swarm-director \
    --workers 12 --max-tokens 1300 --order breadth --priority 1
Restart=on-failure
RestartSec=60
# Ať se log dá číst po chuncích, ne až na konci
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
