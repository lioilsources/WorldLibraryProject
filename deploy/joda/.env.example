# Postgres knihovního katalogu na JODA. Zkopírovat na .env a doplnit heslo —
# .env je mimo git i mimo rsync (deploy-joda ho nepřepisuje).

# Heslo role `library` (db `library`). Stejnou hodnotu potřebuje PG_DSN
# v rag/.env na SPARKu (server, loader) a na M2 (migrace, eval).
LIBRARY_PG_PASSWORD=zmen-me

# Datový adresář na hostu. Musí být pod /home nebo /media (snap docker).
# Docker ho při prvním startu založí sám (root), stejně jako u Chromy.
LIBRARY_PG_DATA=/media/storage/library-pg

# Kam padají noční zálohy (pg_dump, komprimované; 14 dní / 4 týdny / 3 měsíce).
LIBRARY_PG_BACKUPS=/media/storage/library-pg-backups

# Data knihovní Chromy (:8007). Záměrně na SSD (/home), ne na /media (HDD).
LIBRARY_CHROMA_DATA=/home/oli/deploy/WorldLibraryProject/chroma-data
