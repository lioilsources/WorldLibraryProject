# Lokální nastavení RAG (zkopírovat na rag/.env — ten je mimo git).
# Čte ho Makefile (-include), server.py, embed_books.py, load_pg.py,
# pg_migrate.py, enrich_*.py a eval.

# Knihovní Postgres na JODA (deploy/joda; heslo je v deploy/joda/.env tamtéž)
PG_DSN=postgresql://library:HESLO@192.168.88.88:5433/library

# Knihovní Chroma na SPARKu (:8007, NVMe; přesunuto z JODY 2026-09-12).
# Na SPARKu samotném stačí 127.0.0.1, odjinud v LAN 192.168.88.66.
CHROMA_URL=http://192.168.88.66:8007

# Kolekce pasáží pro server v PG režimu
COLLECTION=books_v2

# Volitelně: fp32 místo fp16 na CUDA (index i dotaz musí jet stejně)
# EMBED_DTYPE=fp32

# Plánovač dotazu (intent + přepis): off = jen hybridní retrieval bez LLM roundtripu
# PLANNER=off
# PLANNER_MODEL=translate
