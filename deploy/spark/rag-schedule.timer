# 00:00 promo (ClownPROMO), 01:00 rag (obohacení korpusu), 07:00 comfy.
#
# Jeden timer pro obě hodiny a režim si odvodí skript z hodin — díky tomu
# smí být Persistent=true, aniž by reboot ve 3 ráno nastartoval ComfyUI:
# `auto` se srovná podle skutečného času, ne podle toho, který spouštěč utekl.
#
# Okno ragu je 6 h, z toho ~5 min sežere výměna modelů (director se nahrává
# 2:40, translate 2:25). Zbývá ~355 min × 7,3 chunku/min ≈ 2 600 chunků za noc;
# při 56 183 chuncích ve frontě (16. 9. 2026) je to ~22 nocí.
#
#   systemctl --user enable --now rag-schedule.timer
#   systemctl --user list-timers rag-schedule.timer
#   systemctl --user stop rag-schedule.timer      # vypnout rozvrh

[Unit]
Description=Rozvrh denního a nočního režimu SPARKu

[Timer]
OnCalendar=*-*-* 00,01,07:00:00
OnBootSec=3min
Persistent=true
Unit=rag-schedule.service

[Install]
WantedBy=timers.target
